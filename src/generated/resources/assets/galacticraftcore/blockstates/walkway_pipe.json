{
  "multipart": [
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe"
      }
    },
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe_side",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe_side",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "galacticraftcore:block/walkway_pipe_down"
      },
      "when": {
        "down": "true"
      }
    }
  ]
}